{
  "name": "app-vue-electron",
  "private": true,
  "version": "0.0.0",
  "description": "Sistema de gestión de clubs estudiantiles",
  "author": "Tu Nombre",
  "main": "electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:vite\" \"npm run dev:electron\" \"npm run dev:php\"",
    "dev:vite": "vite",
    "dev:php": "\"C:\\xampp\\php\\php.exe\" -S 127.0.0.1:8000 -t Backend",
    "dev:electron": "cross-env NODE_ENV=development wait-on http://localhost:5173 && electron electron/main.js",
    "build": "vite build && electron-builder"
  },
  "dependencies": {
    "axios": "^1.13.2",
    "bootstrap": "^5.3.8",
    "bootstrap-icons": "^1.13.1",
    "html2pdf.js": "^0.14.0",
    "jspdf": "^3.0.4",
    "jszip": "^3.10.1",
    "vue": "^3.5.22",
    "vue-router": "^4.6.3"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.1",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^39.1.0",
    "electron-builder": "^26.0.12",
    "vite": "^7.1.7",
    "wait-on": "^9.0.1"
  },
  "build": {
    "appId": "com.club-systems.app",
    "productName": "Club Systems",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "Backend/**/*",
      "database/**/*",
      "php/**/*"   
    ],
    "win": {
      "icon": "src/Img/lo.ico",
      "target": "nsis"
    }
  }
}
